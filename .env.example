# Ligação à Base de Dados Central na Nuvem (Supabase PostgreSQL)
# Crie um projeto gratuito em https://supabase.com
# Em 'Project Settings' -> 'API', copie a URL e a chave 'anon public'
VITE_SUPABASE_URL=https://exemplo-seu-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...sua-chave-anon-publica-aqui...

# (Opcional) Endereço base da API REST para backend próprio em Node.js
# VITE_API_BASE_URL=https://o-seu-servidor.pt/api
